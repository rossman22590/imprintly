NODE_ENV="development"
PORT="3001"
CLIENT_URL="http://localhost:5173"
DB_URI=""
# Generate the secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=""
# Get an API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=""
# Get an API key from GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=""
DEFAULT_AI_PROVIDER="groq"
GROQ_STRUCTURE_MODEL="openai/gpt-oss-120b"
GROQ_SECTION_MODEL="openai/gpt-oss-20b"
GROQ_STRUCTURE_MAX_TOKENS="12000"
GROQ_SECTION_MAX_TOKENS="9000"
GEMINI_STRUCTURE_MODEL="gemini-3.5-flash"
GEMINI_SECTION_MODEL="gemini-3.5-flash"
GEMINI_QUALITY_MODEL="gemini-3.5-flash"
GEMINI_MAX_OUTPUT_TOKENS="9000"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
GEMINI_IMAGE_SIZE="1K"
PUBLIC_API_URL="http://localhost:3001"
