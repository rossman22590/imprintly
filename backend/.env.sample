NODE_ENV="development"
PORT="3001"
CLIENT_URL="http://localhost:5173"
# Optional comma-separated extra frontend origins, e.g. Render preview/static URLs.
CLIENT_URLS=""
# Only use true for throwaway demos. In production, prefer CLIENT_URL/CLIENT_URLS.
CORS_ALLOW_ALL=""
DB_URI=""
# Generate the secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=""
# Generate separately from JWT_SECRET_KEY. Rotating JWT secrets must not invalidate developer API keys.
API_KEY_HASH_SECRET=""
# Get an API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=""
# Get an API key from GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=""
DEFAULT_AI_PROVIDER="groq"
GROQ_STRUCTURE_MODEL="openai/gpt-oss-120b"
GROQ_SECTION_MODEL="openai/gpt-oss-120b"
GROQ_STRUCTURE_MAX_TOKENS="12000"
GROQ_SECTION_MAX_TOKENS="9000"
GEMINI_STRUCTURE_MODEL="gemini-3.5-flash"
GEMINI_SECTION_MODEL="gemini-3.5-flash"
GEMINI_QUALITY_MODEL="gemini-3.5-flash"
GEMINI_MAX_OUTPUT_TOKENS="16000"
GEMINI_THINKING_LEVEL="low"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
GEMINI_IMAGE_SIZE="1K"
STARTING_CREDITS="500"
BOOKIFY_USD_PER_CREDIT="0.01"
AI_TOKEN_MARKUP_MULTIPLIER="2"
ADMIN_EMAILS="rcohen@mytsi.org"
BOOTSTRAP_FIRST_ADMIN="true"
PUBLIC_API_URL="http://localhost:3001"
RESEND_API_KEY=""
MAIL_FROM_NAME="Bookify"
MAIL_FROM_EMAIL="bookify@myapps.ai"
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
